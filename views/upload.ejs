<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="shortcut icon" href="/favicon.ico?v=2" type="image/x-icon">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/upload.css">
  <link rel="stylesheet" href="/css/card-nav.css">
  <link rel="stylesheet" href="/css/blur-text.css">
  <link rel="stylesheet" href="/css/gradual-blur.css">
</head>
<body class="upload-page page-shell">
  <div class="noise-layer"></div>
  <div class="auth-orb auth-orb-b"></div>
  <div class="auth-orb auth-orb-c"></div>

  <div class="card-nav-container">
    <nav class="card-nav" aria-label="主导航">
      <div class="card-nav-top">
        <div class="hamburger-menu" role="button" aria-label="展开菜单" tabindex="0">
          <div class="hamburger-line"></div>
          <div class="hamburger-line"></div>
        </div>
        <a class="card-nav-logo" href="/home" aria-label="小星音吧首页">✦</a>
        <a href="/api/logout" class="card-nav-cta secondary">退出</a>
      </div>
      <div class="card-nav-content" aria-hidden="true">
        <div class="nav-card">
          <div class="nav-card-label">音乐</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/home">🏠 首页</a>
            <a class="nav-card-link" href="#">🔍 探索发现</a>
            <a class="nav-card-link" href="#">🔥 热门新声</a>
          </div>
        </div>
        <div class="nav-card">
          <div class="nav-card-label">空间</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/myspace">👤 <%= user.nickname || user.username %></a>
            <a class="nav-card-link" href="/upload">📤 上传音乐</a>
          </div>
        </div>
        <div class="nav-card">
          <div class="nav-card-label">账户</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/api/logout">🚪 退出登录</a>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <main class="upload-layout center-shell">
    <section class="upload-intro">
      <span class="eyebrow" data-blur-text="chars">CREATOR STATION</span>
      <h1 data-blur-text="words">把新的旋律上传到社区，把封面、情绪和氛围一起交给听众。</h1>
      <p data-blur-text="words">上传页升级为更明确的创作台体验，适配移动端和桌面端创作者操作。</p>
      <div class="upload-notes">
        <span>支持音频与封面双文件上传</span>
        <span>视觉与表单状态统一</span>
        <span>为后续 Figma 设计映射保留规范</span>
      </div>
    </section>
    <section class="panel-card upload-card deluxe-card">
      <h2 class="upload-title brand-title">管理员上传音乐</h2>
      <p class="upload-subtitle">请填写歌曲信息并上传对应资源</p>
      <form action="/api/upload" method="POST" enctype="multipart/form-data" class="form-stack upload-form-grid">
        <div class="field-group">
          <label class="field-label" for="song-name">歌曲名称</label>
          <input id="song-name" class="field-input" type="text" name="song_name" placeholder="请输入歌曲名" required>
        </div>
        <div class="field-group">
          <label class="field-label" for="singer-name">歌手</label>
          <input id="singer-name" class="field-input" type="text" name="singer" placeholder="请输入歌手名" required>
        </div>
        <div class="field-group">
          <label class="field-label" for="cover-file">封面图片</label>
          <input id="cover-file" class="field-input file-input" type="file" name="cover" accept="image/*" required>
        </div>
        <div class="field-group">
          <label class="field-label" for="music-file">音乐文件（mp3）</label>
          <input id="music-file" class="field-input file-input" type="file" name="music" accept="audio/mpeg" required>
        </div>
        <button type="submit" class="btn btn-primary upload-submit btn-glow">确认上传</button>
      </form>
      <a href="/home" class="upload-back-link">返回主页</a>
    </section>
  </main>

  <script src="/js/gradual-blur.js"></script>
  <script src="/js/blur-text.js"></script>
  <script src="/js/card-nav.js"></script>
</body>
</html>
