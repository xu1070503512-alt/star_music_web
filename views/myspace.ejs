<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.username %> - 个人空间 | 小星音吧</title>
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="shortcut icon" href="/favicon.ico?v=2" type="image/x-icon">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/myspace.css">
  <link rel="stylesheet" href="/css/card-nav.css">
  <link rel="stylesheet" href="/css/blur-text.css">
  <link rel="stylesheet" href="/css/scroll-float.css">
  <link rel="stylesheet" href="/css/gradual-blur.css">
</head>
<body class="page-shell myspace-body">
  <div class="noise-layer"></div>
  <div class="ambient-blob ambient-blob-c"></div>

  <div class="card-nav-container">
    <nav class="card-nav" aria-label="主导航">
      <div class="card-nav-top">
        <div class="hamburger-menu" role="button" aria-label="展开菜单" tabindex="0">
          <div class="hamburger-line"></div>
          <div class="hamburger-line"></div>
        </div>
        <a class="card-nav-logo" href="/home" aria-label="小星音吧首页">✦</a>
        <a href="/api/logout" class="card-nav-cta secondary">退出</a>
      </div>
      <div class="card-nav-content" aria-hidden="true">
        <div class="nav-card">
          <div class="nav-card-label">音乐</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/home">🏠 首页</a>
            <a class="nav-card-link" href="#">🔍 探索发现</a>
            <a class="nav-card-link" href="#">🔥 热门新声</a>
          </div>
        </div>
        <div class="nav-card">
          <div class="nav-card-label">空间</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/myspace">👤 <%= user.nickname || user.username %></a>
            <% if (user.role === 'admin') { %>
              <a class="nav-card-link" href="/upload">📤 上传音乐</a>
            <% } %>
          </div>
        </div>
        <div class="nav-card">
          <div class="nav-card-label">账户</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/api/logout">🚪 退出登录</a>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <main class="page-container myspace-page">
    <section class="profile-hero panel-card glass-panel">
      <div class="profile-identity">
        <div class="avatar neon-ring"><%= (user.nickname || user.username).charAt(0).toUpperCase() %></div>
        <div class="profile-main-copy">
          <span class="eyebrow" data-blur-text="chars">CREATOR PROFILE</span>
          <h1 class="profile-name" data-blur-text="words"><%= user.nickname || user.username %></h1>
          <p class="profile-account">账号：<%= user.username %></p>
          <p class="profile-description" data-blur-text="words">这是你的沉浸式创作者首页，作品、收藏和最近播放都在同一空间里流动。</p>
          <div class="profile-badges">
            <span><%= user.role === 'admin' ? '管理员 / 策展人' : '社区听众 / 收藏者' %></span>
            <span><%= profileMetrics.favoriteArtists %> 位偏爱音乐人</span>
            <span><%= collectCount %> 首长期收藏</span>
          </div>
        </div>
      </div>
      <div class="profile-stat-grid">
        <article><strong><%= collectCount %></strong><span>收藏作品</span></article>
        <article><strong><%= uploadCount %></strong><span>上传作品</span></article>
        <article><strong><%= profileMetrics.totalCollectedPlays %></strong><span>收藏曲目累计播放</span></article>
        <article><strong><%= profileMetrics.totalUploadPlays %></strong><span>上传曲目累计播放</span></article>
      </div>
    </section>

    <section class="profile-content panel-card glass-panel">
      <div class="tabs" role="tablist">
        <button class="tab active" type="button" data-tab="collect">我的收藏</button>
        <% if (user.role === 'admin') { %>
          <button class="tab" type="button" data-tab="upload">我的上传</button>
        <% } %>
        <button class="tab" type="button" data-tab="history">播放历史</button>
      </div>

      <div class="tab-content active" id="collectContent">
        <div class="section-toolbar">
          <h2 class="section-title heading-no-margin" data-scroll-float data-scroll-stagger="0.025">收藏声场</h2>
          <div class="chip-row" id="collectSingerFilters"></div>
        </div>
        <div class="music-grid compact-grid" id="collectGrid">
          <% if (collectList && collectList.length > 0) { %>
            <% for(let item of collectList) { %>
              <article class="music-card compact-card collect-card" data-singer="<%= item.singer %>" data-id="<%= item.id %>">
                <div class="compact-cover-wrap">
                  <img src="<%= item.cover_path %>" class="music-card-cover" alt="封面">
                </div>
                <div class="music-card-body">
                  <div class="music-card-topline">
                    <span class="pill">已收藏</span>
                    <span class="meta-light"><%= item.play_count || 0 %> 次播放</span>
                  </div>
                  <h3 class="music-card-title"><%= item.song_name %></h3>
                  <p class="music-card-subtitle"><%= item.singer %></p>
                  <p class="music-card-uploader">上传者：<%= item.uploader_name %></p>
                  <div class="music-card-actions">
                    <button class="btn btn-primary btn-compact play-btn" type="button" data-src="<%= item.mp3_path %>" data-cover="<%= item.cover_path %>" data-name="<%= item.song_name %>" data-artist="<%= item.singer %>">播放</button>
                    <button class="btn btn-warning btn-compact uncollect-btn" type="button" data-id="<%= item.id %>">取消收藏</button>
                  </div>
                </div>
              </article>
            <% } %>
          <% } %>
        </div>
        <div class="empty-state <%= collectList && collectList.length > 0 ? 'hidden' : '' %>" id="collectEmptyState">暂无收藏歌曲，去首页发现新的声音吧。</div>
      </div>

      <% if (user.role === 'admin') { %>
        <div class="tab-content" id="uploadContent">
          <div class="section-toolbar">
            <h2 class="section-title heading-no-margin" data-scroll-float data-scroll-stagger="0.025">作品管理</h2>
            <span class="toolbar-hint">你上传的曲目将在这里集中管理</span>
          </div>
          <div class="music-grid compact-grid" id="uploadGrid">
            <% if (uploadList && uploadList.length > 0) { %>
              <% for(let item of uploadList) { %>
                <article class="music-card compact-card upload-card-item" data-id="<%= item.id %>">
                  <div class="compact-cover-wrap">
                    <img src="<%= item.cover_path %>" class="music-card-cover" alt="封面">
                  </div>
                  <div class="music-card-body">
                    <div class="music-card-topline">
                      <span class="pill">我的作品</span>
                      <span class="meta-light"><span class="play-count-text"><%= item.play_count || 0 %></span> 次播放</span>
                    </div>
                    <h3 class="music-card-title"><%= item.song_name %></h3>
                    <p class="music-card-subtitle"><%= item.singer %></p>
                    <p class="music-card-uploader">上传者：<%= item.uploader_name %></p>
                    <div class="music-card-actions">
                      <button class="btn btn-primary btn-compact play-btn" type="button" data-src="<%= item.mp3_path %>" data-cover="<%= item.cover_path %>" data-name="<%= item.song_name %>" data-artist="<%= item.singer %>">播放</button>
                      <button class="btn btn-danger btn-compact delete-music-btn" type="button" data-id="<%= item.id %>">删除歌曲</button>
                    </div>
                  </div>
                </article>
              <% } %>
            <% } %>
          </div>
          <div class="empty-state <%= uploadList && uploadList.length > 0 ? 'hidden' : '' %>" id="uploadEmptyState">暂无上传歌曲，去上传页发布你的新作品。</div>
        </div>
      <% } %>

      <div class="tab-content" id="historyContent">
        <div class="section-toolbar">
          <h2 class="section-title heading-no-margin" data-scroll-float data-scroll-stagger="0.025">播放历史</h2>
          <span class="toolbar-hint">基于本地设备最近播放记录生成</span>
        </div>
        <div class="history-grid" id="historyGrid"></div>
        <div class="empty-state" id="historyEmptyState">还没有播放历史，先回首页播放一首歌吧。</div>
      </div>
    </section>
  </main>

  <section class="simple-player-shell">
    <audio controls id="audioPlayer" class="simple-player"></audio>
  </section>

  <script src="/js/gradual-blur.js"></script>
  <script src="/js/blur-text.js"></script>
  <script src="/js/scroll-float.js"></script>
  <script src="/js/card-nav.js"></script>
  <script src="/js/myspace.js"></script>
</body>
</html>
