<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.username %> - 小星音吧</title>
  <link rel="icon" href="/favicon.ico?v=2" type="image/x-icon">
  <link rel="shortcut icon" href="/favicon.ico?v=2" type="image/x-icon">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/card-nav.css">
  <link rel="stylesheet" href="/css/blur-text.css">
  <link rel="stylesheet" href="/css/scroll-float.css">
  <link rel="stylesheet" href="/css/gradual-blur.css">
</head>
<body class="page-shell experience-page">
  <canvas id="visualizerCanvas" class="visualizer-canvas" aria-hidden="true"></canvas>
  <div class="noise-layer"></div>
  <div class="ambient-blob ambient-blob-a"></div>
  <div class="ambient-blob ambient-blob-b"></div>

  <div class="card-nav-container">
    <nav class="card-nav" aria-label="主导航">
      <div class="card-nav-top">
        <div class="hamburger-menu" role="button" aria-label="展开菜单" tabindex="0">
          <div class="hamburger-line"></div>
          <div class="hamburger-line"></div>
        </div>
        <a class="card-nav-logo" href="/home" aria-label="小星音吧首页">✦</a>
        <a href="/api/logout" class="card-nav-cta secondary">退出</a>
      </div>
      <div class="card-nav-content" aria-hidden="true">
        <div class="nav-card">
          <div class="nav-card-label">音乐</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/home">🏠 首页</a>
            <a class="nav-card-link" href="#">🔍 探索发现</a>
            <a class="nav-card-link" href="#">🔥 热门新声</a>
          </div>
        </div>
        <div class="nav-card">
          <div class="nav-card-label">空间</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/myspace">👤 <%= user.nickname || user.username %></a>
            <% if(user.role === 'admin'){ %>
              <a class="nav-card-link" href="/upload">📤 上传音乐</a>
            <% } %>
          </div>
        </div>
        <div class="nav-card">
          <div class="nav-card-label">账户</div>
          <div class="nav-card-links">
            <a class="nav-card-link" href="/api/logout">🚪 退出登录</a>
          </div>
        </div>
      </div>
    </nav>
  </div>

  <main class="page-container home-page">
    <section class="hero-panel panel-card glass-panel">
      <div class="hero-copy">
        <span class="eyebrow" data-blur-text="chars">NEON STUDY LOUNGE</span>
        <h1 data-blur-text="words">让旋律、霓虹与注意力在同一空间里共振。</h1>
        <p class="hero-summary" data-blur-text="words">围绕独立音乐、深夜创作和高质感播放体验，构建一个既能沉浸聆听，又能高效管理的声场社区。</p>
        <div class="hero-stats">
          <article>
            <strong><%= communityStats.totalTracks %></strong>
            <span>在库曲目</span>
          </article>
          <article>
            <strong><%= communityStats.totalArtists %></strong>
            <span>独立音乐人</span>
          </article>
          <article>
            <strong><%= communityStats.totalPlays %></strong>
            <span>累计播放</span>
          </article>
          <article>
            <strong><%= communityStats.collectedCount %></strong>
            <span>我的收藏</span>
          </article>
        </div>
        <div class="hero-actions">
          <button id="toggleVisualizerBtn" class="btn btn-primary btn-glow" type="button">关闭可视化</button>
          <a href="/myspace" class="btn btn-secondary" type="button">进入个人空间</a>
        </div>
      </div>
      <aside class="hero-feature-card">
        <span class="feature-label">Now Featuring</span>
        <% if (featuredTrack) { %>
          <div class="feature-cover-wrap">
            <img src="<%= featuredTrack.cover_path %>" alt="<%= featuredTrack.song_name %> 封面" class="feature-cover">
          </div>
          <h2><%= featuredTrack.song_name %></h2>
          <p><%= featuredTrack.singer %> · <%= featuredTrack.uploader_name %></p>
          <div class="feature-meta">
            <span><%= featuredTrack.play_count || 0 %> 次播放</span>
            <span><%= featuredTrack.uploader_role === 'admin' ? '官方上传' : '社区上传' %></span>
          </div>
        <% } else { %>
          <div class="feature-empty">音乐库暂时为空，等待新的声音进入这片夜色。</div>
        <% } %>
      </aside>
    </section>

    <section class="toolbar-panel panel-card glass-panel">
      <div class="toolbar-main">
        <label class="search-box" for="musicSearchInput">
          <span>搜索歌曲 / 音乐人</span>
          <input id="musicSearchInput" class="field-input toolbar-input" type="text" placeholder="输入歌名、歌手或上传者">
        </label>
        <div class="filter-chip-group" id="filterChipGroup">
          <button class="filter-chip active" type="button" data-filter="all">全部</button>
          <button class="filter-chip" type="button" data-filter="collected">已收藏</button>
          <button class="filter-chip" type="button" data-filter="uncollected">未收藏</button>
          <button class="filter-chip" type="button" data-filter="popular">热门优先</button>
        </div>
      </div>
      <div class="toolbar-meta">
        <span id="resultCountText">共 <%= musicList.length %> 首曲目</span>
        <span class="toolbar-hint">支持顺序 / 循环 / 随机播放、音量记忆、可视化开关</span>
      </div>
    </section>

    <section class="music-grid-section">
      <div class="section-heading-row">
        <div>
          <span class="eyebrow" data-scroll-float>COMMUNITY TRACKS</span>
          <h2 class="section-title heading-no-margin" data-scroll-float data-scroll-stagger="0.025">沉浸式音乐列表</h2>
        </div>
      </div>
      <div class="music-grid" id="musicGrid">
        <% for(let item of musicList) { %>
          <article
            class="music-card"
            data-music-id="<%= item.id %>"
            data-name="<%= item.song_name %>"
            data-singer="<%= item.singer %>"
            data-uploader="<%= item.uploader_name %>"
            data-cover="<%= item.cover_path %>"
            data-src="<%= item.mp3_path %>"
            data-play-count="<%= item.play_count || 0 %>"
            data-collected="<%= collectedIds && collectedIds.includes(item.id) ? 'true' : 'false' %>">
            <div class="music-card-cover-wrap">
              <img src="<%= item.cover_path %>" class="music-card-cover" alt="<%= item.song_name %> 封面">
              <div class="music-card-glow"></div>
              <div class="music-card-overlay">
                <button
                  class="play-fab"
                  type="button"
                  aria-label="播放 <%= item.song_name %>"
                  data-cover="<%= item.cover_path %>"
                  data-name="<%= item.song_name %>"
                  data-artist="<%= item.singer %>"
                  data-uploader="<%= item.uploader_name %>"
                  data-src="<%= item.mp3_path %>"
                  data-id="<%= item.id %>">▶</button>
              </div>
            </div>
            <div class="music-card-body">
              <div class="music-card-topline">
                <span class="pill"><%= item.uploader_role === 'admin' ? '官方推荐' : '社区共创' %></span>
                <span class="meta-light"><span class="play-count-text"><%= item.play_count || 0 %></span> 次播放</span>
              </div>
              <h3 class="music-card-title"><%= item.song_name %></h3>
              <p class="music-card-subtitle"><%= item.singer %></p>
              <p class="music-card-uploader">上传者：<%= item.uploader_name %></p>
              <div class="music-card-actions">
                <button
                  class="btn btn-primary btn-compact play-btn"
                  type="button"
                  data-cover="<%= item.cover_path %>"
                  data-name="<%= item.song_name %>"
                  data-artist="<%= item.singer %>"
                  data-uploader="<%= item.uploader_name %>"
                  data-src="<%= item.mp3_path %>"
                  data-id="<%= item.id %>">播放</button>
                <button
                  class="btn btn-accent btn-compact collect-btn <%= collectedIds && collectedIds.includes(item.id) ? 'is-collected' : '' %>"
                  type="button"
                  data-id="<%= item.id %>"
                  <%= collectedIds && collectedIds.includes(item.id) ? 'disabled' : '' %>>
                  <%= collectedIds && collectedIds.includes(item.id) ? '已收藏' : '收藏' %>
                </button>
              </div>
            </div>
          </article>
        <% } %>
      </div>
      <div class="empty-state hidden" id="musicEmptyState">当前筛选条件下没有找到曲目。</div>
    </section>
  </main>

  <section class="player-shell">
    <div class="player-card glass-panel">
      <div class="player-cover-frame neon-ring">
        <img id="playerCover" src="<%= featuredTrack ? featuredTrack.cover_path : '/favicon.ico' %>" alt="当前播放封面">
      </div>
      <div class="player-info">
        <div class="player-kicker">Now Playing</div>
        <div class="player-song-name" id="playerName"><%= featuredTrack ? featuredTrack.song_name : '未播放歌曲' %></div>
        <div class="player-song-artist" id="playerArtist"><%= featuredTrack ? featuredTrack.singer : '——' %></div>
      </div>
      <div class="player-controls">
        <button class="ctrl-btn prev" id="prevBtn" type="button">
          <img src="/images/Previous.svg" alt="上一首">
        </button>
        <button class="ctrl-btn play" id="playBtn" type="button">
          <img src="/images/Play.svg" alt="播放 / 暂停">
        </button>
        <button class="ctrl-btn next" id="nextBtn" type="button">
          <img src="/images/Next.svg" alt="下一首">
        </button>
      </div>
      <div class="progress-area">
        <div class="time" id="time">00:00 / 00:00</div>
        <div class="progress" id="progress">
          <div class="bar" id="bar"></div>
        </div>
      </div>
      <button class="mode-switch" id="modeBtn" type="button">
        <img src="/images/Loop.svg" alt="播放模式">
        <span id="modeLabel">顺序</span>
      </button>
      <div class="volume-container">
        <div class="elastic-slider-wrapper">
          <button class="elastic-slider-left-icon" id="volumeBtn" type="button">
            <img src="/images/Volume.svg" alt="音量">
          </button>
          <div class="elastic-slider-root" id="elasticVolumeSlider" role="slider" aria-label="音量控制" aria-valuemin="0" aria-valuemax="100" aria-valuenow="85" tabindex="0">
            <div class="elastic-slider-track-wrapper">
              <div class="elastic-slider-track">
                <div class="elastic-slider-range" id="elasticVolumeFill"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button class="icon-btn" id="playlistBtn" type="button">
        <img src="/images/List.svg" alt="播放列表">
      </button>
    </div>
    <div class="playlist-panel" id="playlistPanel"></div>
  </section>

  <audio id="audioPlayer"></audio>
  <script>
    window.__STAR_MUSIC_HOME__ = {
      userId: <%= user.id %>,
      initialMode: 'sequence'
    };
  </script>
  <script src="/js/gradual-blur.js"></script>
  <script src="/js/blur-text.js"></script>
  <script src="/js/scroll-float.js"></script>
  <script src="/js/card-nav.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>
